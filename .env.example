# Gemini / AI — Backend only（勿把 key 放到 NEXT_PUBLIC_*）
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_ANALYZE_MODEL=gemini-3.5-flash

# （可選過渡）舊 Manus：未設 GEMINI_API_KEY 時先回退
# MANUS_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.manus.im/v1

# Supabase
# Client（可公開）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server（@supabase/server / admin client；SECRET 勿放 NEXT_PUBLIC_*）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# 可選：JSON map 形式（@supabase/server named keys）
# SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_xxx"}
# SUPABASE_SECRET_KEYS={"default":"sb_secret_xxx"}
# SUPABASE_JWKS={"keys":[...]}

# Auth（必須改成隨機長字串）
AUTH_SECRET=please-change-to-a-long-random-string

# MySQL（正式環境建議；有設則 users + customers 走 DB）
# 擇一：拆開變數，或 DATABASE_URL / MYSQL_URL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sme
MYSQL_PASSWORD=sme_dev_pass
MYSQL_DATABASE=sme_loanflow
# MYSQL_SSL=true
# MYSQL_CONNECTION_LIMIT=5
# DATABASE_URL=mysql://sme:sme_dev_pass@127.0.0.1:3306/sme_loanflow

# 帳戶持久化備援（未設 MySQL 時）：Upstash Redis 或 Vercel KV
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 手機 OTP — Twilio Verify（API Key 或 Account SID + Auth Token）
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxx
# TWILIO_API_KEY_SECRET=xxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx   # 若不用 API Key 才需要
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# —— 開戶文件通 WhatsApp 通知（擇一 provider）——
# 公開網址（訊息內 deep link）
# NEXT_PUBLIC_APP_URL=https://hk-bank-account.vercel.app
# 審核員接收號碼（可多個，逗號分隔）
# BIZ_REVIEWER_WHATSAPP=+85291234567,+85298765432
#
# A) Meta WhatsApp Cloud API
# WHATSAPP_TOKEN=EAAxxxx
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_NAME=bizdoc_notify   # 可選；未設則發 text（需 24h 視窗）
# WHATSAPP_TEMPLATE_LANG=zh_HK
#
# B) Twilio WhatsApp
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# （共用上方 TWILIO_ACCOUNT_SID / AUTH_TOKEN 或 API Key）
#
# C) 自建／Make／n8n Webhook
# WHATSAPP_WEBHOOK_URL=https://hooks.example.com/whatsapp
# WHATSAPP_WEBHOOK_SECRET=optional-bearer-token

# RAG Knowledge Base（預留）
RAG_PROVIDER=stub
# RAG_API_URL=
# RAG_API_KEY=
# RAG_INDEX=

# CRM API（預留）
CRM_PROVIDER=stub
# CRM_API_URL=
# CRM_API_KEY=
# CRM_PIPELINE_ID=

# Resend 電郵（Backend only；補件通知等）
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=SME LoanFlow <onboarding@resend.dev>
