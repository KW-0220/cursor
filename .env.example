# Manus / AI — Backend only（勿把 key 放到 NEXT_PUBLIC_*）
# 可用 MANUS_API_KEY 或 OPENAI_API_KEY（同值）
MANUS_API_KEY=sk-your-manus-key-here
OPENAI_API_KEY=sk-your-manus-key-here
OPENAI_BASE_URL=https://api.manus.im/v1
OPENAI_MODEL=manus-1.6
# OPENAI_ANALYZE_MODEL=manus-1.6

# Auth（必須改成隨機長字串）
AUTH_SECRET=please-change-to-a-long-random-string

# 帳戶持久化（Vercel 建議）：Upstash Redis 或 Vercel KV
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 手機 OTP — Twilio Verify（API Key 或 Account SID + Auth Token）
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxx
# TWILIO_API_KEY_SECRET=xxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx   # 若不用 API Key 才需要
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# OCR — 掃描 PDF／圖片抽字（有夠字就唔送 Manus vision）
# auto：有 Google key 用 Vision，否則 tesseract.js；google | tesseract | off
OCR_PROVIDER=auto
# Google Cloud Vision API key（DOCUMENT_TEXT_DETECTION；港文件繁中＋英最穩）
# GOOGLE_CLOUD_VISION_API_KEY=
# 本地 tesseract 語言（預設繁中+英；可用 chi_sim+eng）
# OCR_TESSERACT_LANGS=chi_tra+eng

# RAG Knowledge Base（預留）
RAG_PROVIDER=stub
# RAG_API_URL=
# RAG_API_KEY=
# RAG_INDEX=

# CRM API（預留）
CRM_PROVIDER=stub
# CRM_API_URL=
# CRM_API_KEY=
# CRM_PIPELINE_ID=
