# Manus / AI — Backend only（勿把 key 放到 NEXT_PUBLIC_*）
# 可用 MANUS_API_KEY 或 OPENAI_API_KEY（同值）
MANUS_API_KEY=sk-your-manus-key-here
OPENAI_API_KEY=sk-your-manus-key-here
OPENAI_BASE_URL=https://api.manus.im/v1
OPENAI_MODEL=manus-1.6
# OPENAI_ANALYZE_MODEL=manus-1.6

# Auth（必須改成隨機長字串）
AUTH_SECRET=please-change-to-a-long-random-string

# 帳戶持久化（Vercel 建議）：Upstash Redis 或 Vercel KV
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# —— 申請草稿／主資料庫（規格：SQL 主庫）——
# file（預設）：data/applications.json；有 Redis 時一併寫入
# postgres：接 DATABASE_URL 後跑 sql/001_loan_applications.sql（adapter 預留）
DATABASE_PROVIDER=file
# DATABASE_URL=postgresql://user:pass@host:5432/sme_loanflow
# 草稿過期日數（預設 90）
# DRAFT_EXPIRY_DAYS=90

# —— Object Storage（規格：文件唔入 SQL）——
# local：data/uploads/；s3：預留 AWS S3
STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# 手機 OTP — Twilio Verify（API Key 或 Account SID + Auth Token）
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxx
# TWILIO_API_KEY_SECRET=xxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx   # 若不用 API Key 才需要
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# RAG Knowledge Base（預留）
RAG_PROVIDER=stub
# RAG_API_URL=
# RAG_API_KEY=
# RAG_INDEX=

# CRM API（預留）
CRM_PROVIDER=stub
# CRM_API_URL=
# CRM_API_KEY=
# CRM_PIPELINE_ID=
